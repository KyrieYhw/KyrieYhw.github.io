---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../consts';
import { formatDate, readingTime } from '../utils';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  rawBody?: string;
}
const { title, description = '', pubDate, updatedDate, tags = [], rawBody = '' } = Astro.props;
---
<BaseLayout title={title} description={description} page="blog">
  <article class="post wrap">
    <header class="post-head measure">
      <div class="post-meta mono">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(rawBody)}</span>
      </div>
      <h1 class="post-title serif">{title}</h1>
      {description && <p class="post-desc">{description}</p>}
      {tags.length > 0 && (
        <ul class="post-tags">
          {tags.map((t) => (
            <li><a href={`/tags/${t}/`} class="tag">#{t}</a></li>
          ))}
        </ul>
      )}
    </header>

    <div class="post-body measure">
      <slot />
    </div>

    {updatedDate && (
      <footer class="post-foot measure mono">
        更新于 {formatDate(updatedDate)}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-5);
  }
  .post-head {
    margin-bottom: var(--space-5);
  }
  .post-meta {
    font-size: var(--fs-meta);
    color: var(--ink-faint);
    display: flex;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }
  .post-title {
    font-size: var(--fs-h2);
    line-height: 1.35;
    margin: 0 0 var(--space-2);
  }
  .post-desc {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0;
  }
  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    margin: var(--space-3) 0 0;
  }
  .tag {
    font-size: var(--fs-small);
    color: var(--seal);
    font-family: var(--font-mono);
  }
  .tag:hover { text-decoration: underline; }
  .post-foot {
    margin-top: var(--space-5);
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
    font-size: var(--fs-meta);
    color: var(--ink-faint);
  }
</style>
