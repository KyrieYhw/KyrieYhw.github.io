---
import { SITE } from '../consts';
import Seal from './Seal.astro';
interface Props { page?: string; }
const { page = '' } = Astro.props;
const links = [
  { href: '/', label: '首页', key: 'home' },
  { href: '/blog/', label: '文章', key: 'blog' },
  { href: '/about/', label: '关于', key: 'about' },
];
---
<header class="site-head">
  <div class="wrap head-inner">
    <a href="/" class="brand" aria-label="回到首页">
      <Seal text={SITE.sealText} size={38} />
      <span class="brand-name serif">{SITE.title}</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {links.map((l) => (
        <a
          href={l.href}
          class="nav-link"
          aria-current={page === l.key ? 'page' : undefined}
        >{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-head {
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(6px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .head-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand-name {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .nav {
    display: flex;
    gap: 1.75rem;
  }
  .nav-link {
    font-size: var(--fs-small);
    color: var(--ink-soft);
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .nav-link:hover {
    color: var(--ink);
    border-color: var(--seal);
  }
  /* 高亮当前页 */
  .nav-link[aria-current="page"] {
    color: var(--ink);
    border-color: var(--seal);
  }
  @media (max-width: 480px) {
    .nav { gap: 1rem; }
  }
</style>
