---
/**
 * 印章 —— 整个页面的签名元素。
 * 一个朱砂红的方印,刻着站点名,像盖在笔记本上的私章。
 */
interface Props {
  size?: number;
  text: string;
}
const { size = 44, text } = Astro.props;
const chars = text.slice(0, 4).split('');
---
<div
  class="seal"
  role="img"
  aria-label={`站点印章 ${text}`}
  style={{ width: size + 'px', height: size + 'px' }}
>
  <span class="seal-inner">{chars.map((c) => <span class="seal-char">{c}</span>)}</span>
</div>

<style>
  .seal {
    flex: none;
    border: 2px solid var(--seal);
    color: var(--seal);
    display: grid;
    place-items: center;
    padding: 3px;
    border-radius: 4px;
  }
  .seal-inner {
    width: 100%;
    height: 100%;
    border: 1px solid var(--seal);
    border-radius: 2px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    place-items: center;
    padding: 2px;
  }
  .seal-char {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.5em;
    line-height: 1;
  }
</style>
