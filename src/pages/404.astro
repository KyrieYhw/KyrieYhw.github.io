---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" description="404">
  <section class="wrap nf">
    <p class="eyebrow mono">404</p>
    <h1 class="serif">这页不存在,或者它已经搬家了。</h1>
    <p>
      <a href="/" class="serif nf-link">← 回到首页</a>
    </p>
  </section>
</BaseLayout>

<style>
  .nf { padding: var(--space-6) 0; }
  .nf h1 { font-size: var(--fs-h2); margin: 0.5rem 0 var(--space-3); }
  .nf-link { color: var(--seal); }
  .nf-link:hover { text-decoration: underline; }
</style>
